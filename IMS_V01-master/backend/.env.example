# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=nexted_advisors
# Pending migrations run automatically on start. Set to false to run them by hand
# with `npm run migration:run`.
DB_MIGRATIONS_RUN=true

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login lasts, in seconds (43200 = 12 hours)
JWT_EXPIRES_IN_SECONDS=43200

# First admin, created/promoted by `npm run seed` (password only used when the user is new)
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# ─── HTTP ────────────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Set to true when running behind nginx / a hosting proxy
TRUST_PROXY=false
JSON_BODY_LIMIT=15mb

# ─── Files ───────────────────────────────────────────────────────────────────
PDF_STORAGE_PATH=storage/invoices
# Student documents (passport, transcripts, ...) are saved here, not in the DB
STORAGE_DIR=storage/documents

# ─── Currency ────────────────────────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=free_or_empty

# ─── Meta Lead Ads (optional) ────────────────────────────────────────────────
# Webhook callback URL in Meta: https://<backend-domain>/webhooks/meta
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
# Comma-separated lead form IDs for the "Sync from Meta" button
META_FORM_IDS=

# ─── Other nextED systems (student account linking) ──────────────────────────
# key:Label pairs. Adjust to the real systems.
EXTERNAL_SYSTEMS=nexted_platform:NextEd Platform,ielts_ai:IELTS AI by nextED
# Optional per system (KEY is the upper-cased key above):
# EXTERNAL_NEXTED_PLATFORM_LOOKUP_URL=https://crm.nexted.app/api/students/lookup
# EXTERNAL_NEXTED_PLATFORM_API_KEY=
# EXTERNAL_NEXTED_PLATFORM_PROFILE_URL=https://crm.nexted.app/students/{id}
# EXTERNAL_NEXTED_PLATFORM_SIGNUP_URL=https://crm.nexted.app/register
